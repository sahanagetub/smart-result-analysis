<% layout('../layouts/main') -%>
<link rel="stylesheet" href="/css/dashboard.css">

<section class="dashboard" aria-label="Academic performance dashboard">
  <div id="dashboardLoading" class="dashboard-notice" role="status">Loading dashboard data…</div>
  <div id="dashboardError" class="dashboard-notice dashboard-error" role="alert" hidden></div>
  <div id="dashboardEmpty" class="dashboard-notice" role="status" hidden>No results match the selected filters.</div>

  <section class="dashboard-filters card" aria-label="Dashboard filters">
    <div class="dashboard-filter">
      <label for="filterBatch">Academic batch</label>
      <select id="filterBatch"><option value="">All batches</option></select>
    </div>
    <div class="dashboard-filter">
      <label for="filterSemester">Semester</label>
      <select id="filterSemester"><option value="">All semesters</option></select>
    </div>
    <div class="dashboard-filter">
      <label for="filterSession">Examination session</label>
      <select id="filterSession"><option value="">All sessions</option></select>
    </div>
    <div class="dashboard-filter">
      <label for="filterSubject">Subject</label>
      <select id="filterSubject"><option value="">All subjects</option></select>
    </div>
    <div class="dashboard-filter-actions">
      <button id="applyFilters" class="btn btn-primary" type="button">Apply filters</button>
      <button id="resetFilters" class="btn btn-secondary" type="button">Reset</button>
    </div>
  </section>

  <section class="dashboard-stats" aria-label="Dashboard summary">
    <article class="dashboard-stat card"><div class="dashboard-stat-top"><span class="dashboard-stat-label">Total students</span><span class="dashboard-stat-icon tone-teal"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path d="M3 20v-2a6 6 0 0 1 12 0v2zm14-15a3 3 0 0 1 0 6m1 3a5 5 0 0 1 3 5v1"/></svg></span></div><strong id="totalStudents">—</strong></article>
    <article class="dashboard-stat card"><div class="dashboard-stat-top"><span class="dashboard-stat-label">Batches</span><span class="dashboard-stat-icon tone-gold"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h18v13H3zM7 7V4h10v3M3 11h18"/></svg></span></div><strong id="totalBatches">—</strong></article>
    <article class="dashboard-stat card"><div class="dashboard-stat-top"><span class="dashboard-stat-label">Semesters</span><span class="dashboard-stat-icon tone-blue"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4m10-4v4M3 10h18"/></svg></span></div><strong id="totalSemesters">—</strong></article>
    <article class="dashboard-stat card"><div class="dashboard-stat-top"><span class="dashboard-stat-label">Subjects</span><span class="dashboard-stat-icon tone-violet"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16v16H4zM8 8h8M8 12h8M8 16h5"/></svg></span></div><strong id="totalSubjects">—</strong></article>
    <article class="dashboard-stat card"><div class="dashboard-stat-top"><span class="dashboard-stat-label">Exam sessions</span><span class="dashboard-stat-icon tone-blue"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span></div><strong id="totalExamSessions">—</strong></article>
    <article class="dashboard-stat card"><div class="dashboard-stat-top"><span class="dashboard-stat-label">Result records</span><span class="dashboard-stat-icon tone-teal"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h11l4 4v14H5zM15 3v5h5M8 12h8m-8 4h8"/></svg></span></div><strong id="totalResults">—</strong></article>
    <article class="dashboard-stat card"><div class="dashboard-stat-top"><span class="dashboard-stat-label">Pass rate</span><span class="dashboard-stat-icon tone-green"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg></span></div><strong id="passPercentage">—</strong></article>
    <article class="dashboard-stat card"><div class="dashboard-stat-top"><span class="dashboard-stat-label">Failure rate</span><span class="dashboard-stat-icon tone-coral"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7l10 10M17 7 7 17"/></svg></span></div><strong id="failurePercentage">—</strong></article>
    <article class="dashboard-stat card"><div class="dashboard-stat-top"><span class="dashboard-stat-label">Average marks</span><span class="dashboard-stat-icon tone-gold"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19V5m0 14h17M8 15l4-4 3 2 5-7"/></svg></span></div><strong id="averageMarks">—</strong></article>
  </section>

  <section class="dashboard-panel card">
    <div class="dashboard-panel-heading">
      <div>
        <h2>Top-performing students</h2>
        <p>Ranked by average percentage across the filtered result records. Tied averages share rank.</p>
      </div>
      <label class="topper-limit" for="topperLimit">Show
        <select id="topperLimit"><option value="3">3</option><option value="5" selected>5</option><option value="10">10</option></select>
      </label>
    </div>
    <div class="dashboard-table-wrap">
      <table id="topperTable" class="dashboard-table">
        <thead><tr><th>Rank</th><th>Student</th><th>Batch</th><th>Average percentage</th><th>Results</th></tr></thead>
        <tbody><tr><td colspan="5">Loading…</td></tr></tbody>
      </table>
    </div>
  </section>

  <section class="dashboard-panel card">
    <h2>Recent examination summary</h2>
    <div id="recentExamsList" class="recent-exams"><p>Loading…</p></div>
  </section>

  <section class="dashboard-charts" aria-label="Performance charts">
    <article class="dashboard-chart card"><h2>Pass and fail results</h2><div class="chart-wrap"><canvas id="passFailChart" aria-label="Pass and fail result counts"></canvas></div></article>
    <article class="dashboard-chart card"><h2>Grade distribution</h2><div class="chart-wrap"><canvas id="gradeDistributionChart" aria-label="Stored result grade counts"></canvas></div></article>
    <article class="dashboard-chart card"><h2>Semester-wise pass rate</h2><div class="chart-wrap"><canvas id="semesterChart" aria-label="Pass percentage by semester"></canvas></div></article>
    <article class="dashboard-chart card"><h2>Examination-wise pass rate</h2><div class="chart-wrap"><canvas id="examWiseChart" aria-label="Pass percentage by examination session"></canvas></div></article>
    <article class="dashboard-chart card dashboard-chart-wide"><h2>Subject-wise average percentage</h2><div class="chart-wrap chart-wrap-tall"><canvas id="subjectChart" aria-label="Average percentage by subject"></canvas></div></article>
  </section>
</section>

<script src="/vendor/chart.js/chart.umd.js"></script>
<script src="/js/dashboard.js"></script>

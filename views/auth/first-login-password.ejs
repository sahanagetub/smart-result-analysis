<% layout('../layouts/main') -%>

<section class="card first-login-password-card">
  <div class="first-login-lock" aria-hidden="true">🔐</div>
  <p class="first-login-eyebrow">FIRST SIGN IN</p>
  <h2>Set your own password</h2>
  <p class="first-login-copy">Your temporary password has been accepted. Set a new password now. You’ll be signed out and must sign in again with it.</p>
  <div id="passwordChangeMessage" class="status-banner" role="status" aria-live="polite" hidden></div>
  <form id="firstLoginPasswordForm" class="first-login-password-form" novalidate>
    <label for="newPassword">New password<input id="newPassword" name="newPassword" type="password" minlength="8" maxlength="128" autocomplete="new-password" required /></label>
    <label for="confirmPassword">Confirm new password<input id="confirmPassword" name="confirmPassword" type="password" minlength="8" maxlength="128" autocomplete="new-password" required /></label>
    <p class="first-login-hint">Use 8 to 128 characters. Avoid reusing your temporary password.</p>
    <button id="saveFirstPassword" class="btn btn-primary" type="submit">Update password</button>
  </form>
</section>
<script src="/js/first-login-password.js"></script>

<style>
  .first-login-password-card{max-width:540px;margin:0 auto;padding:clamp(22px,4vw,36px)}
  .first-login-lock{font-size:1.7rem;margin-bottom:.5rem}
  .first-login-eyebrow{color:var(--primary);font-size:.7rem;font-weight:800;letter-spacing:.13em}
  .first-login-password-card h2{font-size:1.35rem;margin:.2rem 0 .45rem}
  .first-login-copy,.first-login-hint{color:var(--muted);font-size:.88rem}
  .first-login-password-form{display:grid;gap:1rem;margin-top:1.2rem}
  .first-login-password-form label{display:grid;gap:.4rem;font-size:.85rem;font-weight:700}
  .first-login-password-form input{width:100%;min-height:42px}
  .first-login-password-form .btn{justify-self:start;min-width:180px}
  @media(max-width:520px){.first-login-password-form .btn{width:100%}}
</style>

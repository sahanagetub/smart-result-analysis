<% layout('../layouts/main') -%>
<link rel="stylesheet" href="/css/analytics.css">

<main class="analytics-page" aria-labelledby="analyticsTitle">
  <header class="analytics-header"><div><h1 id="analyticsTitle">Academic Analytics</h1><p>Explore historical results, grades and performance comparisons.</p></div></header>
  <form id="analyticsFilters" class="analytics-filters">
    <label>Batch <select id="filterBatch"><option value="">All batches</option></select></label>
    <label>Academic year <select id="filterYear"><option value="">All years</option></select></label>
    <label>Semester <select id="filterSemester"><option value="">All semesters</option></select></label>
    <label>Examination <select id="filterSession"><option value="">All examinations</option></select></label>
    <label>Subject <select id="filterSubject"><option value="">All subjects</option></select></label>
    <label>Student search <input id="studentSearch" type="search" maxlength="80" placeholder="USN or student name"></label>
    <label>Compare by <select id="comparisonDimension"><option value="batch">Batch</option><option value="academicYear">Academic year</option><option value="semester" selected>Semester</option><option value="examination">Examination</option><option value="subject">Subject</option></select></label>
    <div class="analytics-actions"><button class="btn btn-primary" type="submit">Apply filters</button><button class="btn" id="resetAnalytics" type="button">Reset</button></div>
    <p class="analytics-schema-note">Results use stored combined marks, grades and pass/fail status. CIE/SEE, revaluation and backlog history are not stored.</p>
  </form>

  <div id="analyticsLoading" class="analytics-message" role="status" hidden>Loading analytics…</div>
  <div id="analyticsError" class="analytics-message analytics-error" role="alert" hidden></div>
  <div id="analyticsEmpty" class="analytics-message" hidden>No result data matches these filters.</div>

  <section class="analytics-stats" aria-label="Overview metrics">
    <article class="card"><h2>Students</h2><strong id="totalStudents">—</strong></article>
    <article class="card"><h2>Results</h2><strong id="totalResults">—</strong></article>
    <article class="card"><h2>Pass rate</h2><strong id="passPercent">—</strong></article>
    <article class="card"><h2>Failure rate</h2><strong id="failurePercent">—</strong></article>
    <article class="card"><h2>Average marks</h2><strong id="averageMarks">—</strong></article>
    <article class="card"><h2>Average percentage</h2><strong id="averagePercentage">—</strong></article>
  </section>

  <section class="analytics-grid">
    <article class="card analytics-panel"><h2>Pass and fail</h2><div class="analytics-chart"><canvas id="passFailChart" aria-label="Pass and fail result counts"></canvas></div></article>
    <article class="card analytics-panel"><h2>Grade distribution</h2><div class="analytics-chart"><canvas id="gradeChart" aria-label="Stored grade distribution"></canvas></div></article>
    <article class="card analytics-panel"><h2>Grades by semester</h2><div class="analytics-chart"><canvas id="gradeSemesterChart" aria-label="Grade distribution compared by semester"></canvas></div></article>
    <article class="card analytics-panel"><h2>Grades by examination</h2><div class="analytics-chart"><canvas id="gradeExaminationChart" aria-label="Grade distribution compared by examination"></canvas></div></article>
    <article class="card analytics-panel"><h2>Semester performance</h2><div class="analytics-chart"><canvas id="semesterChart" aria-label="Semester pass and average percentages"></canvas></div></article>
    <article class="card analytics-panel"><h2>Examination comparison</h2><div class="analytics-chart"><canvas id="examinationChart" aria-label="Examination pass percentage"></canvas></div></article>
    <article class="card analytics-panel"><h2>Selected dimension comparison</h2><div class="analytics-chart"><canvas id="comparisonChart" aria-label="Selected dimension average percentage"></canvas></div></article>
    <article class="card analytics-panel analytics-wide"><h2>Subject comparison</h2><div class="analytics-chart analytics-chart-tall"><canvas id="subjectChart" aria-label="Subject average and pass percentage"></canvas></div></article>
  </section>

  <section class="card analytics-table-panel"><h2>Subject performance</h2><div class="analytics-table-wrap"><table class="data-table"><thead><tr><th>Subject</th><th>Semester</th><th>Results</th><th>Passed</th><th>Failed</th><th>Pass %</th><th>Average marks</th><th>Grades</th></tr></thead><tbody id="subjectRows"></tbody></table></div></section>

  <section class="card analytics-table-panel"><h2>Student performance</h2><div class="analytics-table-wrap"><table class="data-table"><thead><tr><th>USN</th><th>Student</th><th>Batch</th><th>Results</th><th>Pass %</th><th>CGPA*</th><th>Semester results</th></tr></thead><tbody id="studentRows"></tbody></table></div><p class="analytics-schema-note">* CGPA uses stored grades and subject credits through the project calculation service. It is blank for partial scopes or ambiguous repeat attempts. SGPA needs a selected examination session.</p></section>
</main>

<script src="/vendor/chart.js/chart.umd.js"></script>
<script src="/js/analytics.js"></script>

<% layout('../layouts/main') -%>

<div id="dbStatus" class="status-banner" style="display:none;"></div>

<div class="cards-grid">
  <div class="card stat-card">
    <h3>Overall Pass %</h3>
    <p class="stat-value" id="passPercent">-</p>
  </div>
  <div class="card stat-card">
    <h3>Total Students</h3>
    <p class="stat-value" id="totalStudents">-</p>
  </div>
  <div class="card stat-card">
    <h3>Appeared Students</h3>
    <p class="stat-value" id="appearedStudents">-</p>
  </div>
  <div class="card stat-card">
    <h3>Passed Students</h3>
    <p class="stat-value" id="passedStudents">-</p>
  </div>
  <div class="card stat-card">
    <h3>Failed Students</h3>
    <p class="stat-value" id="failedStudents">-</p>
  </div>
  <div class="card stat-card">
    <h3>Class Average %</h3>
    <p class="stat-value" id="classAveragePercentage">-</p>
  </div>
  <div class="card stat-card">
    <h3>Highest Score</h3>
    <p class="stat-value" id="highestScore">-</p>
  </div>
  <div class="card stat-card">
    <h3>Lowest Score</h3>
    <p class="stat-value" id="lowestScore">-</p>
  </div>
  <div class="card stat-card">
    <h3>Total Results</h3>
    <p class="stat-value" id="totalResults">-</p>
  </div>
</div>

<div class="overview-grid">
  <div class="card overview-card">
    <h3>Class Analysis</h3>
    <div class="chart-wrap"><canvas id="classAnalysisChart"></canvas></div>
    <table id="classAnalysisTable" class="data-table">
      <thead>
        <tr>
          <th>Metric</th>
          <th>Value</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>Total Pass Count</td><td id="classTotalPassCount">-</td></tr>
        <tr><td>Total Fail Count</td><td id="classTotalFailCount">-</td></tr>
        <tr><td>Pass Percentage</td><td id="classPassPercentage">-</td></tr>
        <tr><td>Average Percentage</td><td id="classAveragePercentage">-</td></tr>
        <tr><td>Highest Percentage</td><td id="classHighestPercentage">-</td></tr>
        <tr><td>Lowest Percentage</td><td id="classLowestPercentage">-</td></tr>
      </tbody>
    </table>
  </div>
  <div class="card overview-card">
    <h3>Subject Analysis</h3>
    <div class="chart-wrap"><canvas id="subjectAnalysisChart"></canvas></div>
    <table id="subjectAnalysisTable" class="data-table">
      <thead>
        <tr>
          <th>Subject</th>
          <th>Appeared</th>
          <th>Passed</th>
          <th>Failed</th>
          <th>Pass %</th>
          <th>Avg Marks</th>
          <th>Highest</th>
          <th>Lowest</th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </div>
  <div class="card overview-card">
    <h3>Toppers</h3>
    <table id="toppersTable" class="data-table">
      <thead>
        <tr>
          <th>Rank</th>
          <th>USN</th>
          <th>Student Name</th>
          <th>Total Marks</th>
          <th>Percentage</th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </div>
</div>

<div class="filters-bar">
  <div class="filter-group">
    <label>Batch</label>
    <select id="filterBatch">
      <option value="">All Batches</option>
    </select>
  </div>
  <div class="filter-group">
    <label>Semester</label>
    <select id="filterSemester">
      <option value="">All Semesters</option>
    </select>
  </div>
  <div class="filter-group">
    <label>Session</label>
    <select id="filterSession">
      <option value="">All Sessions</option>
    </select>
  </div>
  <div class="filter-group">
    <label>Show</label>
    <select id="topperLimit">
      <option value="3">Top 3</option>
      <option value="5" selected>Top 5</option>
      <option value="10">Top 10</option>
    </select>
  </div>
  <button id="refreshAnalytics" class="btn btn-primary">Refresh Analytics</button>
</div>

<div id="analyticsError" class="alert alert-error" style="display:none;"></div>

<script src="/vendor/chart.js/chart.umd.js"></script>
<script src="/js/analytics.js"></script>

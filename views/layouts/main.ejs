<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> - Smart Result Analysis</title>
  <link rel="stylesheet" href="/css/style.css" />
  <%- include('../partials/head_styles'); %>
</head>
<body>
  <header class="top-navbar">
    <div class="brand">
      <img src="/images/logo.svg?v=20261118" alt="Smart Student Result Analysis mark" class="logo" />
      <span class="brand-title">Smart Student Result Analysis</span>
    </div>
    <div class="navbar-right">
      <% if (user) { %>
        <div class="clerk-profile">
          <span class="clerk-name" id="userInfo"><%= user.displayName || user.username %></span>
          <span class="clerk-role"><%= (user.role || 'clerk').charAt(0).toUpperCase() + (user.role || 'clerk').slice(1) %></span>
        </div>
        <button id="logoutBtn" class="btn-logout">Logout</button>
      <% } %>
    </div>
  </header>

  <div class="app-shell">
    <aside class="sidebar" id="sidebar">
      <nav>
        <ul class="nav-list">
          <%- include('../partials/sidebar', { active: active }); %>
        </ul>
      </nav>
    </aside>

    <main class="main-content">
      <%- include('../partials/flash'); %>

      <div class="page-header">
        <span class="page-title-icon" aria-hidden="true">
          <% if (active === 'dashboard') { %><svg viewBox="0 0 24 24"><path d="M3 13h8V3H3zm10 8h8V11h-8zm0-18v6h8V3zM3 21h8v-6H3z"/></svg>
          <% } else if (active === 'batches') { %><svg viewBox="0 0 24 24"><path d="M3 7h18v13H3zM7 7V4h10v3M3 11h18"/></svg>
          <% } else if (active === 'students') { %><svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><path d="M3 20v-2a6 6 0 0 1 12 0v2zm14-15a3 3 0 0 1 0 6m1 3a5 5 0 0 1 3 5v1"/></svg>
          <% } else if (active === 'semesters') { %><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4m10-4v4M3 10h18"/></svg>
          <% } else if (active === 'sessions') { %><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          <% } else if (active === 'subjects') { %><svg viewBox="0 0 24 24"><path d="M4 4h16v16H4zM8 8h8M8 12h8M8 16h5"/></svg>
          <% } else if (active === 'results' || active === 'resultUpload') { %><svg viewBox="0 0 24 24"><path d="M5 3h11l4 4v14H5zM15 3v5h5M8 12h8m-8 4h8"/></svg>
          <% } else if (active === 'analytics') { %><svg viewBox="0 0 24 24"><path d="M4 20V4m0 16h17M8 16v-5m5 5V7m5 9v-8"/></svg>
          <% } else { %><svg viewBox="0 0 24 24"><path d="M5 3h11l4 4v14H5zM15 3v5h5M8 12h8m-8 4h8"/></svg><% } %>
        </span>
        <h1><%= title %></h1>
      </div>

      <%- body %>
    </main>
  </div>

  <footer class="site-footer">
    <p>&copy; 2026 Smart Student Result Analysis and Academic Performance Prediction System.</p>
  </footer>

  <script src="/js/api.js"></script>
  <script src="/js/main.js"></script>
  <%- include('../partials/foot_scripts'); %>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> - Smart Result Analysis</title>
  <link rel="stylesheet" href="/css/style.css" />
  <%- include('../partials/head_styles'); %>
</head>
<body>
  <header class="top-navbar">
    <div class="brand">
      <img src="/images/logo.svg" alt="Logo" class="logo" />
      <span class="brand-title">Smart Student Result Analysis</span>
    </div>
    <div class="navbar-right">
      <% if (user) { %>
        <div class="clerk-profile">
          <span class="clerk-name" id="userInfo"><%= user.displayName || user.username %></span>
          <span class="clerk-role"><%= (user.role || 'clerk').charAt(0).toUpperCase() + (user.role || 'clerk').slice(1) %></span>
        </div>
        <button id="logoutBtn" class="btn-logout">Logout</button>
      <% } %>
    </div>
  </header>

  <div class="app-shell">
    <aside class="sidebar" id="sidebar">
      <nav>
        <ul class="nav-list">
          <%- include('../partials/sidebar', { active: active }); %>
        </ul>
      </nav>
    </aside>

    <main class="main-content">
      <%- include('../partials/flash'); %>

      <div class="page-header">
        <h1><%= title %></h1>
      </div>

      <%- body %>
    </main>
  </div>

  <footer class="site-footer">
    <p>&copy; 2026 Smart Student Result Analysis and Academic Performance Prediction System.</p>
  </footer>

  <script src="/js/main.js"></script>
  <%- include('../partials/foot_scripts'); %>
</body>
</html>
<% layout('../layouts/main') -%>

<div class="card form-card">
  <div class="card-header">
    <h3>Upload Result</h3>
    <a href="/results" class="btn btn-link text-reset">&larr; Back to Result Records</a>
  </div>
  <div class="card-body">
    <div class="status-banner status-info">
      <strong>Coming soon.</strong> Result upload will accept CSV/XLSX files with columns: USN, Subject Code, Marks Obtained, Max Marks.
    </div>
    <form id="resultUploadForm" enctype="multipart/form-data" novalidate style="margin-top:20px; display:none;">
      <div class="form-group">
        <label for="resultFile">Select File <span class="required">*</span></label>
        <input type="file" id="resultFile" name="resultFile" accept=".csv,.xlsx" required />
      </div>
      <div class="form-group">
        <label for="resultExamSession">Exam Session <span class="required">*</span></label>
        <select id="resultExamSession" name="exam_session_id" required>
          <option value="">Select an exam session...</option>
        </select>
      </div>
      <div id="resultPreview" style="margin-top:12px; display:none;"></div>
      <div class="form-actions" style="margin-top:12px;">
        <button type="submit" id="confirmResultUploadBtn" class="btn btn-primary">Confirm Upload</button>
      </div>
    </form>
  </div>
</div>

<script src="/js/main.js"></script>
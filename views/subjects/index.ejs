<% layout('../layouts/main') -%>

<div id="dbStatusBanner" class="status-banner status-warn" style="display:none;">
  Database is disabled (demo mode). Subject operations are unavailable until MySQL is enabled.
</div>
<div id="pageMessage" class="status-banner status-info" style="display:none;"></div>

<div class="toolbar" style="margin-bottom:20px;">
  <button id="addSubjectBtn" class="btn btn-primary">+ Add Subject</button>
  <div class="search-box"><input type="text" id="subjectSearch" placeholder="Search subjects by name or code..." /></div>
</div>

<div class="card table-card">
  <div class="table-wrapper">
    <table id="subjectsTable">
      <thead>
        <tr>
          <th>Subject Code</th>
          <th>Subject Name</th>
          <th>Semester</th>
          <th>Credits</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody id="subjectsTableBody">
        <tr><td colspan="6" class="empty-row">Loading subjects...</td></tr>
      </tbody>
    </table>
  </div>
</div>

<div id="addSubjectForm" class="card form-card" style="display:none; margin-top:20px;">
  <div class="card-header"><h3>Add Subject</h3><button id="cancelSubjectBtn" class="btn btn-secondary">Cancel</button></div>
  <form id="subjectForm" novalidate>
    <input type="hidden" id="subjectId" />
    <div class="form-row">
      <div class="form-group">
        <label for="subjectCode">Subject Code <span class="required">*</span></label>
        <input type="text" id="subjectCode" name="subject_code" placeholder="e.g. MCA101" maxlength="20" />
        <span class="field-error" id="errSubjectCode"></span>
      </div>
      <div class="form-group">
        <label for="subjectName">Subject Name <span class="required">*</span></label>
        <input type="text" id="subjectName" name="subject_name" placeholder="e.g. Data Structures" />
        <span class="field-error" id="errSubjectName"></span>
      </div>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label for="subjectSemester">Semester <span class="required">*</span></label>
        <select id="subjectSemester" name="semester_id">
          <option value="">Select a semester...</option>
        </select>
        <span class="field-error" id="errSubjectSemester"></span>
      </div>
      <div class="form-group">
        <label for="subjectCredits">Credits <span class="required">*</span></label>
        <input type="number" id="subjectCredits" name="credits" min="1" max="10" placeholder="e.g. 4" />
        <span class="field-error" id="errSubjectCredits"></span>
      </div>
    </div>
    <div class="form-group">
      <label for="subjectStatus">Status <span class="required">*</span></label>
      <select id="subjectStatus" name="status">
        <option value="Active">Active</option>
        <option value="Inactive">Inactive</option>
      </select>
      <span class="field-error" id="errSubjectStatus"></span>
    </div>
    <div class="form-actions" style="margin-top:12px;">
      <button type="submit" id="saveSubjectBtn" class="btn btn-primary">Save Subject</button>
    </div>
  </form>
</div>

<script src="/js/main.js"></script>
<script src="/js/subjects.js"></script>
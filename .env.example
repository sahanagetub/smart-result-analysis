# Application
PORT=3000
NODE_ENV=development

# MySQL
DB_DISABLED=true
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_result_analysis

# Test data generator stays disabled unless explicitly enabled for a dedicated test/sandbox/dev database.
ALLOW_TEST_DATA_GENERATION=false
TEST_DATA_DATABASE_NAME=

# Session
# Replace with a unique random value of at least 32 characters before production deployment.
SESSION_SECRET=change_this_to_a_long_random_string

# Optional first administrator; set these only during a controlled bootstrap.
# Generate ADMIN_PASSWORD_HASH locally with: node -e "require('bcrypt').hash(process.argv[1], 12).then(console.log)" "your-new-password"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_DISPLAY_NAME=

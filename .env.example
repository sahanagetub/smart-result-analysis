# Application
PORT=3000
NODE_ENV=development

# MySQL
DB_DISABLED=false
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_local_mysql_password
DB_NAME=smart_result_analysis

# Session
# Replace with a unique random value of at least 32 characters before production deployment.
SESSION_SECRET=change_this_to_a_long_random_string

# The single Admin/Clerk account. Database-backed accounts are Staff only.
# Generate ADMIN_PASSWORD_HASH locally with: node -e "require('bcrypt').hash(process.argv[1], 12).then(console.log)" "your-new-password"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_DISPLAY_NAME=

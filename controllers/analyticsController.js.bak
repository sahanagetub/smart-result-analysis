const analyticsModel = require('../models/analyticsModel');
const { isDbDisabled } = require('../config/db');

/**
 * GET /api/analytics/overview
 * Returns overall student performance statistics from the database.
 */
exports.getOverview = async (req, res) => {
  try {
    const dbAvailable = !isDbDisabled();
    const filters = [];

    const { batchId, semesterId, sessionId } = req.query;

    if (batchId) filters.push(['b.id = ?', [batchId]]);
    if (semesterId) filters.push(['s.semester_id = ?', [semesterId]]);
    if (sessionId) filters.push(['r.exam_session_id = ?', [sessionId]]);

    let overall = {
      totalStudents: 0,
      appearedStudents: 0,
      passedStudents: 0,
      failedStudents: 0,
      passPercentage: 0,
      classAveragePercentage: 0,
      highestScore: 0,
      lowestScore: 0,
      totalResults: 0,
      filteredResultCount: 0
    };

    if (dbAvailable) {
      try {
        const sqlParts = [];
        const params = [];

        sqlParts.push(`
          SELECT
            (SELECT COUNT(*) FROM students) AS totalStudents,
            COUNT(DISTINCT r.usn) AS appearedStudents,
            SUM(CASE WHEN r.status = 'Pass' THEN 1 ELSE 0 END) AS passedStudents,
            SUM(CASE WHEN r.status = 'Fail' THEN 1 ELSE 0 END) AS failedStudents,
            SUM(1) AS totalResults,
            ROUND(AVG(r.marks_obtained / r.max_marks * 100), 2) AS classAveragePercentage,
            MAX(r.marks_obtained) AS highestScore,
            MIN(r.marks_obtained) AS lowestScore
          FROM results r
        `);

        if (filters.length > 0) {
          sqlParts.push('WHERE ');
          const andParts = [];
          for (let i = 0; i < filters.length; i++) {
            if (i > 0) andParts.push('AND ');
            andParts.push(filters[i][0]);
          }
          sqlParts.push(andParts.join(' '));
          params.push(...filters.flatMap((f) => f[1]));
        }

        const [rows] = await analyticsModel.executeQuery(sqlParts.join(''), params);

        if (rows && rows.length > 0) {
          const row = rows[0];
          overall = {
            totalStudents: Number(row.totalStudents) || 0,
            appearedStudents: Number(row.appearedStudents) || 0,
            passedStudents: Number(row.passedStudents) || 0,
            failedStudents: Number(row.failedStudents) || 0,
            passPercentage: row.totalResults > 0 ? Number(((Number(row.passedStudents) / Number(row.totalResults)) * 100).toFixed(2)) : 0,
            classAveragePercentage: row.classAveragePercentage !== null && row.classAveragePercentage !== undefined ? Number(Number(row.classAveragePercentage).toFixed(2)) : 0,
            highestScore: row.highestScore !== null && row.highestScore !== undefined ? Number(Number(row.highestScore).toFixed(2)) : 0,
            lowestScore: row.lowestScore !== null && row.lowestScore !== undefined ? Number(Number(row.lowestScore).toFixed(2)) : 0,
            totalResults: Number(row.totalResults) || 0,
            filteredResultCount: Number(row.totalResults) || 0
          };
        }
      } catch (err) {
        console.error('Overview analytics DB error:', err.message);
      }
    }

    res.json({
      success: true,
      data: overall
    });
  } catch (err) {
    console.error('Overview analytics error:', err.message);
    res.status(500).json({ success: false, error: err.message });
  }
};

/**
 * GET /api/analytics/class
 * Returns class-level pass/fail and percentage statistics.
 */
exports.getClassAnalysis = async (req, res) => {
  try {
    const dbAvailable = !isDbDisabled();
    const filters = [];

    const { batchId, semesterId, sessionId } = req.query;

    if (batchId) filters.push(['b.id = ?', [batchId]]);
    if (semesterId) filters.push(['s.semester_id = ?', [semesterId]]);
    if (sessionId) filters.push(['r.exam_session_id = ?', [sessionId]]);

    let classAnalysis = {
      totalPassCount: 0,
      totalFailCount: 0,
      passPercentage: 0,
      averagePercentage: 0,
      highestPercentage: 0,
      lowestPercentage: 0,
      totalAppearances: 0,
      filteredResultCount: 0
    };

    if (dbAvailable) {
      try {
        const sqlParts = [];
        const params = [];

        sqlParts.push(`
          SELECT
            SUM(CASE WHEN r.status = 'Pass' THEN 1 ELSE 0 END) AS totalPassCount,
            SUM(CASE WHEN r.status = 'Fail' THEN 1 ELSE 0 END) AS totalFailCount,
            COUNT(*) AS totalAppearances,
            ROUND(AVG(r.marks_obtained / r.max_marks * 100), 2) AS averagePercentage,
            MAX(r.marks_obtained / r.max_marks * 100) AS highestPercentage,
            MIN(r.marks_obtained / r.max_marks * 100) AS lowestPercentage
          FROM results r
        `);

        if (filters.length > 0) {
          sqlParts.push('WHERE ');
          const andParts = [];
          for (let i = 0; i < filters.length; i++) {
            if (i > 0) andParts.push('AND ');
            andParts.push(filters[i][0]);
          }
          sqlParts.push(andParts.join(' '));
          params.push(...filters.flatMap((f) => f[1]));
        }

        const [rows] = await analyticsModel.executeQuery(sqlParts.join(''), params);

        if (rows && rows.length > 0) {
          const row = rows[0];
          classAnalysis = {
            totalPassCount: Number(row.totalPassCount) || 0,
            totalFailCount: Number(row.totalFailCount) || 0,
            passPercentage: row.totalAppearances > 0 ? Number(((Number(row.totalPassCount) / Number(row.totalAppearances)) * 100).toFixed(2)) : 0,
            averagePercentage: row.averagePercentage !== null && row.averagePercentage !== undefined ? Number(Number(row.averagePercentage).toFixed(2)) : 0,
            highestPercentage: row.highestPercentage !== null && row.highestPercentage !== undefined ? Number(Number(row.highestPercentage).toFixed(2)) : 0,
            lowestPercentage: row.lowestPercentage !== null && row.lowestPercentage !== undefined ? Number(Number(row.lowestPercentage).toFixed(2)) : 0,
            totalAppearances: Number(row.totalAppearances) || 0,
            filteredResultCount: Number(row.totalAppearances) || 0
          };
        }
      } catch (err) {
        console.error('Class analysis DB error:', err.message);
      }
    }

    res.json({
      success: true,
      data: classAnalysis
    });
  } catch (err) {
    console.error('Class analysis error:', err.message);
    res.status(500).json({ success: false, error: err.message });
  }
};

/**
 * GET /api/analytics/subjects
 * Returns subject-wise statistics based on result records and subject metadata.
 */
exports.getSubjectAnalysis = async (req, res) => {
  try {
    const dbAvailable = !isDbDisabled();
    const filters = [];

    const { batchId, semesterId, sessionId } = req.query;

    if (batchId) filters.push(['b.id = ?', [batchId]]);
    if (semesterId) filters.push(['s.semester_id = ?', [semesterId]]);
    if (sessionId) filters.push(['r.exam_session_id = ?', [sessionId]]);

    let subjects = [];
    let filteredResultCount = 0;

    if (dbAvailable) {
      try {
        const sqlParts = [];
        const params = [];

        sqlParts.push(`
          SELECT
            s.subject_code AS subject_code,
            s.subject_name AS subject_name,
            s.total_maximum_marks AS subject_max_marks,
            COUNT(r.id) AS appeared,
            SUM(CASE WHEN r.status = 'Pass' THEN 1 ELSE 0 END) AS passed,
            SUM(CASE WHEN r.status = 'Fail' THEN 1 ELSE 0 END) AS failed,
            ROUND(AVG(r.marks_obtained), 2) AS averageMarks,
            MAX(r.marks_obtained) AS highestMarks,
            MIN(r.marks_obtained) AS lowestMarks
          FROM subjects s
          LEFT JOIN results r
            ON r.subject_code = s.subject_code
        `);

        if (filters.length > 0) {
          sqlParts.push('WHERE ');
          const andParts = [];
          for (let i = 0; i < filters.length; i++) {
            if (i > 0) andParts.push('AND ');
            andParts.push(filters[i][0]);
          }
          sqlParts.push(andParts.join(' '));
          params.push(...filters.flatMap((f) => f[1]));
        }

        sqlParts.push(' GROUP BY s.id, s.subject_code, s.subject_name, s.total_maximum_marks ORDER BY s.subject_code');

        const [rows] = await analyticsModel.executeQuery(sqlParts.join(''), params);

        if (rows && rows.length > 0) {
          subjects = rows.map((row) => ({
            subjectCode: row.subject_code || '',
            subjectName: row.subject_name || '',
            maxMarks: Number(row.subject_max_marks) || 100,
            appeared: Number(row.appeared) || 0,
            passed: Number(row.passed) || 0,
            failed: Number(row.failed) || 0,
            passPercentage: row.appeared > 0 ? Number(((Number(row.passed) / Number(row.appeared)) * 100).toFixed(2)) : 0,
            averageMarks: row.averageMarks !== null && row.averageMarks !== undefined ? Number(Number(row.averageMarks).toFixed(2)) : 0,
            highestMarks: row.highestMarks !== null && row.highestMarks !== undefined ? Number(Number(row.highestMarks).toFixed(2)) : 0,
            lowestMarks: row.lowestMarks !== null && row.lowestMarks !== undefined ? Number(Number(row.lowestMarks).toFixed(2)) : 0
          }));
        }

        filteredResultCount = subjects.reduce((sum, s) => sum + s.appeared, 0);
      } catch (err) {
        console.error('Subject analysis DB error:', err.message);
      }
    }

    res.json({
      success: true,
      data: subjects,
      meta: { totalSubjects: subjects.length, filteredResultCount }
    });
  } catch (err) {
    console.error('Subject analysis error:', err.message);
    res.status(500).json({ success: false, error: err.message });
  }
};

/**
 * GET /api/analytics/toppers
 * Returns ranked students by total marks and percentage for the selected filter.
 */
exports.getToppers = async (req, res) => {
  try {
    const dbAvailable = !isDbDisabled();
    const filters = [];

    const { limit = '5', batchId, semesterId, sessionId } = req.query;

    const parsedLimit = parseInt(limit, 10);
    if (!Number.isInteger(parsedLimit) || parsedLimit < 1 || parsedLimit > 50) {
      return res.status(400).json({
        success: false,
        error: 'Limit must be an integer between 1 and 50.'
      });
    }

    let toppers = [];
    let rankingCount = 0;

    if (dbAvailable) {
      try {
        const sqlParts = [];
        const params = [];

        sqlParts.push(`
          SELECT
            r.usn,
            s.name AS student_name,
            SUM(r.marks_obtained) AS total_marks,
            ROUND(AVG(r.marks_obtained / r.max_marks * 100), 2) AS percentage,
            COUNT(DISTINCT r.subject_code) AS subjects_appeared
          FROM results r
          JOIN students s ON r.usn = s.usn
        `);

        if (filters.length > 0) {
          sqlParts.push('WHERE ');
          const andParts = [];
          for (let i = 0; i < filters.length; i++) {
            if (i > 0) andParts.push('AND ');
            andParts.push(filters[i][0]);
          }
          sqlParts.push(andParts.join(' '));
          params.push(...filters.flatMap((f) => f[1]));
        }

        sqlParts.push(`
          GROUP BY r.usn, s.name
          ORDER BY percentage DESC
          LIMIT ?
        `);
        params.push(parsedLimit);

        const [rows] = await analyticsModel.executeQuery(sqlParts.join(''), params);

        if (rows && rows.length > 0) {
          toppers = rows.map((row, index) => ({
            rank: index + 1,
            usn: row.usn,
            studentName: row.student_name || '',
            totalMarks: row.total_marks !== null && row.total_marks !== undefined ? Number(Number(row.total_marks).toFixed(2)) : 0,
            percentage: row.percentage !== null && row.percentage !== undefined ? Number(Number(row.percentage).toFixed(2)) : 0,
            subjectsAppeared: Number(row.subjects_appeared) || 0
          }));
        }

        rankingCount = toppers.length;
      } catch (err) {
        console.error('Topper ranking DB error:', err.message);
      }
    }

    res.json({
      success: true,
      data: toppers,
      meta: {
        limit: parsedLimit,
        totalRanking: rankingCount,
        filteredResultCount: rankingCount
      }
    });
  } catch (err) {
    console.error('Topper ranking error:', err.message);
    res.status(500).json({ success: false, error: err.message });
  }
};
